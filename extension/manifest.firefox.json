{
  "manifest_version": 2,
  "name": "HyprBlocker",
  "version": "1.0.0",
  "description": "Blocks websites during focus periods - works with the HyprBlocker daemon",
  "browser_specific_settings": {
    "gecko": {
      "id": "hyprblocker@hyprblocker.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "nativeMessaging",
    "tabs",
    "notifications",
    "webNavigation",
    "alarms",
    "<all_urls>",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "incognito": "split",
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    "blocked.html",
    "blocked.js"
  ]
}
